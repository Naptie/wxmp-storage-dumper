<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>wxmp-storage-dumper</AssemblyName>
    <RootNamespace>WxmpStorageDumper</RootNamespace>
    <!-- Single source of truth: repo-root VERSION file (CI tag must match). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- Offset tables from WMPFDebugger (see PROVENANCE.md). -->
  <ItemGroup>
    <EmbeddedResource Include="..\offsets\addresses.*.json">
      <LogicalName>offsets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The native hook DLL. build-all.cmd (or CI) copies
    native\wmpf-hook\wmpf-hook-<version>.dll to hook-bin\wmpf-hook-<version>.dll
    before building; the wildcard embeds it under its versioned name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="hook-bin\wmpf-hook-*.dll">
      <LogicalName>hook.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
